# Copy this file to .env and fill in your values. Never commit .env.

# AI provider: claude | gemini | openai
AI_PROVIDER=claude

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Google OAuth client (Desktop app) downloaded from Google Cloud Console,
# and where the login token is cached. Paths are relative to this folder.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Password required to open the app (set your own; the app will not open while empty)
APP_PASSWORD=

# Time zone used when clocking in visits (the server may run in UTC)
APP_TIMEZONE=Asia/Kolkata
